        ]
      },
      {
        "name": "Medidas",
        "columns": [
          {
            "name": "Chave",
            "dataType": "int64",
            "sourceColumn": "Chave",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = #table(type table [Chave=Int64.Type], {{1}})",
                "in",
                "    Fonte"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Receita Reconhecida",
            "expression": "SUM(FatoPedidos[recognized_revenue])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Pedidos Totais",
            "expression": "DISTINCTCOUNT(FatoPedidos[order_id])",
            "formatString": "#,0"
          },
          {
            "name": "Pedidos Concluídos",
            "expression": "SUM(FatoPedidos[completed_order_flag])",
            "formatString": "#,0"
          },
          {
            "name": "Pedidos Pendentes",
            "expression": "CALCULATE([Pedidos Totais], FatoPedidos[order_status] = \"pending\")",
            "formatString": "#,0"
          },
          {
            "name": "Pedidos Cancelados",
            "expression": "CALCULATE([Pedidos Totais], FatoPedidos[order_status] = \"cancelled\")",
            "formatString": "#,0"
          },
          {
            "name": "Pedidos Reembolsados",
            "expression": "CALCULATE([Pedidos Totais], FatoPedidos[order_status] = \"refunded\")",
            "formatString": "#,0"
          },
          {
            "name": "Ticket Médio",
            "expression": "DIVIDE([Receita Reconhecida], [Pedidos Concluídos])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Taxa Conclusão %",
            "expression": "DIVIDE([Pedidos Concluídos], [Pedidos Totais])",
            "formatString": "0.0%"
          },
          {
            "name": "Taxa Reembolso %",
            "expression": "DIVIDE([Pedidos Reembolsados], [Pedidos Totais])",
            "formatString": "0.0%"
          },
          {
            "name": "Valor Bruto Itens",
            "expression": "SUM(FatoItens[gross_item_amount])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Descontos Itens",
            "expression": "SUM(FatoItens[discount_amount])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Reembolsos Valor",
            "expression": "SUM(FatoPedidos[refunded_amount])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Receita Itens",
            "expression": "SUM(FatoItens[recognized_item_revenue])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Unidades Pedidos Concluídos",
            "expression": "CALCULATE(SUM(FatoItens[quantity]), FatoItens[order_status] = \"completed\")",
            "formatString": "#,0"
          },
          {
            "name": "Clientes Cadastrados",
            "expression": "DISTINCTCOUNT(DimClientes[customer_id])",
            "formatString": "#,0"
          },
          {
            "name": "Clientes Compradores",
            "expression": "CALCULATE(DISTINCTCOUNT(FatoPedidos[customer_id]), FatoPedidos[order_status] = \"completed\")",
            "formatString": "#,0"
          },
          {
            "name": "Receita por Cliente Comprador",
            "expression": "DIVIDE([Receita Reconhecida], [Clientes Compradores])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Receita Acumulada",
            "expression": "VAR UltimaData = MAX(DimData[Data]) RETURN CALCULATE([Receita Reconhecida], FILTER(ALLSELECTED(DimData[Data]), DimData[Data] <= UltimaData))",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Receita Rolling 7d",
            "expression": "CALCULATE([Receita Reconhecida], DATESINPERIOD(DimData[Data], MAX(DimData[Data]), -7, DAY))",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Receita por Canal - Histórico",
            "expression": "SUM(ResumoCanais[recognized_revenue])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Budget Planejado - Total",
            "expression": "SUM(ResumoCanais[planned_budget_amount])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Pedidos por Canal - Histórico",
            "expression": "SUM(ResumoCanais[order_count])",
            "formatString": "#,0"
          },
          {
            "name": "Pedidos Concluídos por Canal",
            "expression": "SUM(ResumoCanais[completed_orders])",
            "formatString": "#,0"
          },
          {
            "name": "Ticket Médio por Canal",
            "expression": "DIVIDE([Receita por Canal - Histórico], [Pedidos Concluídos por Canal])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Receita Histórica Clientes",
            "expression": "SUM(ResumoClientes[lifetime_recognized_revenue])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Pedidos Históricos Clientes",
            "expression": "SUM(ResumoClientes[lifetime_orders])",
            "formatString": "#,0"
          },
          {
            "name": "Descontos sobre Bruto %",
            "expression": "DIVIDE([Descontos Itens], [Valor Bruto Itens])",
            "formatString": "0.0%"
          },
          {
            "name": "Receita Mês Anterior",
            "expression": "VAR DataAtual = MIN(DimData[Data]) VAR InicioAnterior = EOMONTH(DataAtual, -2) + 1 VAR FimAnterior = EOMONTH(DataAtual, -1) RETURN IF(HASONEVALUE(DimData[AnoMes]), CALCULATE([Receita Reconhecida], REMOVEFILTERS(DimData), DATESBETWEEN(DimData[Data], InicioAnterior, FimAnterior)))",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Variação Receita MoM %",
            "expression": "VAR Anterior = [Receita Mês Anterior] RETURN DIVIDE([Receita Reconhecida] - Anterior, Anterior)",
            "formatString": "0.0%"
          },
          {
            "name": "Receita Média Móvel 7d",
            "expression": "VAR Fim = MAX(DimData[Data]) VAR Primeira = MINX(ALL(DimData[Data]), DimData[Data]) VAR Inicio = MAX(Primeira, Fim - 6) RETURN DIVIDE(CALCULATE([Receita Reconhecida], REMOVEFILTERS(DimData), DATESBETWEEN(DimData[Data], Inicio, Fim)), Fim - Inicio + 1)",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Taxa Cancelamento %",
            "expression": "DIVIDE([Pedidos Cancelados], [Pedidos Totais])",
            "formatString": "0.0%"
          },
          {
            "name": "Desconto Concluídos",
            "expression": "CALCULATE(SUM(FatoItens[discount_amount]), FatoItens[order_status] = \"completed\")",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Bruto Concluídos",
            "expression": "CALCULATE(SUM(FatoItens[gross_item_amount]), FatoItens[order_status] = \"completed\")",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Taxa Desconto Concluídos %",
            "expression": "DIVIDE([Desconto Concluídos], [Bruto Concluídos])",
            "formatString": "0.0%"
          },
          {
            "name": "Clientes Recorrentes (2+)",
            "expression": "COUNTROWS(FILTER(VALUES(DimClientes[customer_id]), CALCULATE([Pedidos Concluídos]) >= 2))",
            "formatString": "#,0"
          },
          {
            "name": "Taxa Recompra Período %",
            "expression": "DIVIDE([Clientes Recorrentes (2+)], [Clientes Compradores])",
            "formatString": "0.0%"
          },
          {
            "name": "Participação Receita Canal %",
            "expression": "DIVIDE([Receita Reconhecida], CALCULATE([Receita Reconhecida], REMOVEFILTERS(FatoPedidos[channel])))",
            "formatString": "0.0%"
          },
          {
            "name": "Participação Receita Produto %",
            "expression": "DIVIDE([Receita Itens], CALCULATE([Receita Itens], ALLSELECTED(DimProdutos)))",
            "formatString": "0.0%"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_pedidos_data",
        "fromTable": "FatoPedidos",
        "fromColumn": "order_date",
        "toTable": "DimData",
        "toColumn": "Data"
      },
      {
        "name": "rel_pedidos_cliente",
        "fromTable": "FatoPedidos",
        "fromColumn": "customer_id",
        "toTable": "DimClientes",
        "toColumn": "customer_id"
      },
      {
        "name": "rel_itens_pedidos",
        "fromTable": "FatoItens",
        "fromColumn": "order_id",
        "toTable": "FatoPedidos",
        "toColumn": "order_id"
      },
      {
        "name": "rel_itens_produtos",
        "fromTable": "FatoItens",
        "fromColumn": "product_id",
        "toTable": "DimProdutos",
        "toColumn": "product_id"
      },
      {
        "name": "rel_clientes_historico",
        "fromTable": "ResumoClientes",
        "fromColumn": "customer_id",
        "toTable": "DimClientes",
        "toColumn": "customer_id"
      }
    ]
  }
}
