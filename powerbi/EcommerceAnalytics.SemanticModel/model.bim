        "partitions": [
          {
            "name": "ResumoCanais",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Url = \"https://raw.githubusercontent.com/Peruzini/analytics-engineering-snowflake-dbt/main/powerbi/data/mart_channel_performance.csv\",",
                "    Fonte = Csv.Document(Web.Contents(Url), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"channel\", type text}, {\"planned_budget_amount\", type number}, {\"order_count\", Int64.Type}, {\"completed_orders\", Int64.Type}, {\"recognized_revenue\", type number}, {\"refunded_amount\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
