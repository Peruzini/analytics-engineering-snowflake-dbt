{
  "name": "EcommerceAnalytics",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "DimData",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "dd/MM/yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "Ano",
            "dataType": "int64",
            "sourceColumn": "Ano",
            "summarizeBy": "none"
          },
          {
            "name": "Mes",
            "dataType": "int64",
            "sourceColumn": "Mes",
            "summarizeBy": "none"
          },
          {
            "name": "AnoMes",
            "dataType": "string",
            "sourceColumn": "AnoMes",
            "summarizeBy": "none"
          },
          {
            "name": "Dia",
            "dataType": "int64",
            "sourceColumn": "Dia",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimData",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Datas = List.Dates(#date(2025, 10, 1), 365, #duration(1,0,0,0)),",
                "    Fonte = Table.FromList(Datas, Splitter.SplitByNothing(), {\"Data\"}),",
                "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Data\", type date}}),",
                "    Ano = Table.AddColumn(Tipos, \"Ano\", each Date.Year([Data]), Int64.Type),",
                "    Mes = Table.AddColumn(Ano, \"Mes\", each Date.Month([Data]), Int64.Type),",
                "    AnoMes = Table.AddColumn(Mes, \"AnoMes\", each Date.ToText([Data], \"yyyy-MM\"), type text),",
                "    Dia = Table.AddColumn(AnoMes, \"Dia\", each Date.Day([Data]), Int64.Type)",
                "in",
                "    Dia"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "DimClientes",
        "columns": [
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "email",
            "dataType": "string",
            "sourceColumn": "email",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "created_at",
            "dataType": "dateTime",
            "sourceColumn": "created_at",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "DimClientes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Url = \"https://raw.githubusercontent.com/Peruzini/analytics-engineering-snowflake-dbt/main/powerbi/data/dim_customers.csv\",",
                "    Fonte = Csv.Document(Web.Contents(Url), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"customer_id\", type text}, {\"email\", type text}, {\"region\", type text}, {\"created_at\", type date}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "DimProdutos",
        "columns": [
          {
            "name": "product_id",
            "dataType": "string",
            "sourceColumn": "product_id",
            "summarizeBy": "none"
          },
          {
            "name": "product_name",
            "dataType": "string",
            "sourceColumn": "product_name",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "list_price",
            "dataType": "double",
            "sourceColumn": "list_price",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "DimProdutos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Url = \"https://raw.githubusercontent.com/Peruzini/analytics-engineering-snowflake-dbt/main/powerbi/data/dim_products.csv\",",
                "    Fonte = Csv.Document(Web.Contents(Url), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"product_id\", type text}, {\"product_name\", type text}, {\"category\", type text}, {\"list_price\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
